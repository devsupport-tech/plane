# Production Environment Variables for Plane
# IMPORTANT: Change all default passwords and keys for production!

# ==================================
# Core Configuration
# ==================================

# Your domain (without protocol)
APP_DOMAIN=plane.team-workspace.us

# Full URL with protocol
WEB_URL=https://plane.team-workspace.us

# API URL (frontend will access this)
NEXT_PUBLIC_API_BASE_URL=https://plane.team-workspace.us/api

# ==================================
# Database Configuration
# ==================================
POSTGRES_USER=plane
POSTGRES_PASSWORD=changeme123!  # CHANGE THIS!
POSTGRES_DB=plane
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432

# ==================================
# Security Keys (MUST CHANGE!)
# ==================================
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_60gp0byfz2dvffa45cxl20p1scy9xbpf6d8c5y0geejgkyp1b5

# ==================================
# Redis Configuration
# ==================================
REDIS_HOST=plane-redis
REDIS_PORT=6379

# ==================================
# RabbitMQ Configuration
# ==================================
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=changeme123!  # CHANGE THIS!
RABBITMQ_VHOST=plane

# ==================================
# Storage Configuration
# ==================================
# Option 1: Use MinIO (self-hosted S3)
USE_MINIO=1
AWS_ACCESS_KEY_ID=minioadmin  # CHANGE THIS!
AWS_SECRET_ACCESS_KEY=minioadmin123  # CHANGE THIS!
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
AWS_REGION=

# Option 2: Use AWS S3 (comment out MinIO settings above and uncomment below)
# USE_MINIO=0
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=plane-uploads
# AWS_S3_ENDPOINT_URL=

# File upload settings
FILE_SIZE_LIMIT=5242880

# ==================================
# SSL/HTTPS Configuration
# ==================================
SSL=true
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
CERT_EMAIL=admin@team-workspace.us  # Your email for Let's Encrypt
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
SITE_ADDRESS=:80

# ==================================
# Application Settings
# ==================================
DEBUG=0
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
CORS_ALLOWED_ORIGINS=

# ==================================
# Optional Features
# ==================================
# Analytics (leave empty if not using)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_CRISP_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# AI Features (leave empty if not using)
OPENAI_API_KEY=
GPT_ENGINE=gpt-3.5-turbo

# ==================================
# Path Configuration (usually don't change)
# ==================================
APP_BASE_PATH=
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_PATH=/spaces
LIVE_BASE_PATH=/live